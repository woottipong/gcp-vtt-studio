# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Optional: Path to service account JSON file
# If not set, will use Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Speech-to-Text V2 Configuration
STT_RECOGNIZER=_
STT_LANGUAGE_CODE=th-TH

# STT Model (Optional - if not set, uses recognizer's default model)
# Uncomment to override recognizer's default:
# STT_MODEL=long
# STT_MODEL=chirp
# STT_MODEL=chirp_2

# File Processing
TEMP_DIR=/tmp/auto_vtt_studio
MAX_FILE_SIZE_MB=500
